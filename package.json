{
  "name": "do",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host --configLoader native",
    "dev:https": "vite --host --https --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --host --configLoader native",
    "lint": "eslint .",
    "collect": "node scripts/collect.mjs",
    "collect:scrapling": "node scripts/run-scrapling.mjs",
    "collect:scrapling:watch": "node scripts/run-scrapling.mjs --interval 30",
    "collect:watch": "node scripts/collect.mjs --interval 30",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^4.1.0",
    "js-sha256": "^0.11.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
